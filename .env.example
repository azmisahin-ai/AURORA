# LLM
AURORA_LLM_PROVIDER=ollama
AURORA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# Workspace
AURORA_WORKSPACE=./workspace
AURORA_KNOWLEDGE_DIR=./knowledge

# Limits
AURORA_MAX_ITERATIONS=25
AURORA_MAX_TOOL_CALLS=50
AURORA_TIMEOUT_MS=120000
AURORA_TOKEN_BUDGET=100000

# Logging
AURORA_LOG_LEVEL=info

# Web research (Phase 3)
AURORA_SEARCH_PROVIDER=noop
AURORA_FETCH_TIMEOUT_MS=30000
AURORA_FETCH_MAX_BYTES=5242880
AURORA_UNTRUSTED_MAX_CHARS=32000

# Verification (Phase 4). Opt-in: with AURORA_TEST_COMMAND unset there is no
# external check and completion is accepted as-is. When set, the agent may not
# report success after changing the workspace until this command exits 0.
AURORA_TEST_COMMAND=
AURORA_TEST_TIMEOUT_MS=300000
AURORA_MAX_VERIFICATIONS=0

# Sub-agents (Phase 5). 0 disables delegation: no `delegate` tool is registered.
# Roles are fixed (researcher, coder, tester, reviewer, documenter) and each has
# its own per-delegation budget; this caps the whole run.
AURORA_MAX_SUB_AGENTS=3

# Tasks (Phase 6). Durable task records; interrupted tasks are requeued on
# restart until they exhaust AURORA_TASK_MAX_ATTEMPTS, after which they fail.
AURORA_TASK_DIR=./tasks
AURORA_TASK_MAX_ATTEMPTS=3

# Memory (Phase 7). Session memory is the durable, cross-restart tier: each run
# leaves a small record (task, status, tools, truncated answer). Recall injects
# a bounded, untrusted-wrapped extract of the most recent prior sessions into a
# new run; 0 disables it. Recall is a no-op with no stored sessions, so a first
# run is unchanged. Context is bounded by AURORA_TOKEN_BUDGET (see Limits).
AURORA_SESSION_DIR=./sessions
AURORA_RECALL_SESSIONS=3

# Security
AURORA_ALLOWED_COMMANDS=npm,node,npx,git,ls,cat,echo
AURORA_BLOCKED_COMMANDS=rm,curl,wget,ssh,scp
