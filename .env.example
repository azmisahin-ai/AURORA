# LLM
AURORA_LLM_PROVIDER=ollama
AURORA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# Workspace
AURORA_WORKSPACE=./workspace
AURORA_KNOWLEDGE_DIR=./knowledge

# Limits
AURORA_MAX_ITERATIONS=25
AURORA_MAX_TOOL_CALLS=50
AURORA_TIMEOUT_MS=120000
AURORA_TOKEN_BUDGET=100000

# Logging
AURORA_LOG_LEVEL=info

# Web research (Phase 3)
AURORA_SEARCH_PROVIDER=noop
AURORA_FETCH_TIMEOUT_MS=30000
AURORA_FETCH_MAX_BYTES=5242880
AURORA_UNTRUSTED_MAX_CHARS=32000

# Verification (Phase 4). Opt-in: with AURORA_TEST_COMMAND unset there is no
# external check and completion is accepted as-is. When set, the agent may not
# report success after changing the workspace until this command exits 0.
AURORA_TEST_COMMAND=
AURORA_TEST_TIMEOUT_MS=300000
AURORA_MAX_VERIFICATIONS=0

# Sub-agents (Phase 5). 0 disables delegation: no `delegate` tool is registered.
# Roles are fixed (researcher, coder, tester, reviewer, documenter) and each has
# its own per-delegation budget; this caps the whole run.
AURORA_MAX_SUB_AGENTS=3

# Tasks (Phase 6). Durable task records; interrupted tasks are requeued on
# restart until they exhaust AURORA_TASK_MAX_ATTEMPTS, after which they fail.
AURORA_TASK_DIR=./tasks
AURORA_TASK_MAX_ATTEMPTS=3

# Memory (Phase 7). Session memory is the durable, cross-restart tier: each run
# leaves a small record (task, status, tools, truncated answer). Recall injects
# a bounded, untrusted-wrapped extract of the most recent prior sessions into a
# new run; 0 disables it. Recall is a no-op with no stored sessions, so a first
# run is unchanged. Context is bounded by AURORA_TOKEN_BUDGET (see Limits).
AURORA_SESSION_DIR=./sessions
AURORA_RECALL_SESSIONS=3

# Security (Phase 8)
AURORA_ALLOWED_COMMANDS=npm,node,npx,git,ls,cat,echo
AURORA_BLOCKED_COMMANDS=rm,curl,wget,ssh,scp

# Redact credential-shaped strings from log events (on by default). Disable only
# for debugging; the model still receives raw tool observations regardless.
AURORA_REDACT_LOGS=true

# Hard cap on a single tool call's serialised arguments.
AURORA_MAX_ARGUMENT_BYTES=65536

# Per-tool token bucket for network tools: capacity (burst) and refill rate
# (tokens/second). 0 disables rate limiting. Guards against loops, not users.
AURORA_TOOL_RATE_LIMIT=20
AURORA_TOOL_RATE_REFILL=1

# What happens before a state-changing tool call (write/edit or command exec):
#   allow  - proceed (default; for unattended runs)
#   deny   - refuse all state-changing calls
#   prompt - ask on the CLI; with no TTY, `aurora run --confirm` proceeds unless
#            AURORA_CONFIRM_STRICT=true, which denies instead.
AURORA_CONFIRM_MODE=allow
AURORA_CONFIRM_STRICT=false

# HTTP API (Phase 9, ADR 011). Loopback by default; a non-loopback bind is
# REFUSED at startup unless AURORA_API_TOKEN is set. Port 0 picks a free port.
AURORA_API_HOST=127.0.0.1
AURORA_API_PORT=8787
# Bearer token required on every route except /health. Leave empty only on a
# loopback bind. Never logged; compared in constant time.
AURORA_API_TOKEN=

# Whether an HTTP run may change the workspace. Default false: an HTTP run uses
# a deny-all confirmation gate, so write_file/edit_file/run_command are refused
# (there is no terminal to confirm them). Set true to opt in, deliberately.
AURORA_API_ALLOW_MUTATION=false

# Request body cap (bytes), enforced while streaming (413 past this).
AURORA_API_MAX_BODY_BYTES=262144
# Per-client token bucket: capacity (burst) and refill (tokens/second).
# 0 disables the limiter. /health is exempt so liveness always answers.
AURORA_API_RATE_LIMIT=60
AURORA_API_RATE_REFILL=1
# Concurrent runs allowed at once; further requests get 429 rather than queueing.
AURORA_API_MAX_CONCURRENT_RUNS=2
# Bound on an inline (?wait=1) request before it answers 202 and keeps running.
AURORA_API_MAX_SYNC_MS=30000

# Operator UI directory, served at / and /ui/* (Phase 10). Static files are read
# through the same PathValidator as the file tools (symlink-aware). An empty
# value, or `serve --no-ui`, disables the UI entirely.
AURORA_UI_DIR=./ui
