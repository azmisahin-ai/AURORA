{
  "name": "aurora",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous Unified Research & Operations Runtime Agent",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "aurora": "dist/cli/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "commander": "^12.1.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "turndown": "^7.2.4",
    "undici": "^8.11.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
